<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:paddingHorizontal="12dp">

        <CheckBox
            android:id="@+id/cb_shopping_purchased"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_shopping_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Olive Oil"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/cb_shopping_purchased"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_move_inventory" />

        <TextView
            android:id="@+id/tv_shopping_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:text="1.0 bottles • Pantry"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/cb_shopping_purchased"
            app:layout_constraintTop_toBottomOf="@id/tv_shopping_name"
            app:layout_constraintEnd_toStartOf="@id/btn_move_inventory" />

        <ImageButton
            android:id="@+id/btn_move_inventory"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_search_bar"
            android:padding="8dp"
            android:contentDescription="Move to Inventory"
            android:src="@drawable/ic_food"
            app:tint="@color/primary"
            app:layout_constraintEnd_toStartOf="@id/btn_delete_shopping"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginEnd="6dp" />

        <ImageButton
            android:id="@+id/btn_delete_shopping"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_search_bar"
            android:padding="8dp"
            android:contentDescription="Delete"
            android:src="@drawable/ic_delete"
            app:tint="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
