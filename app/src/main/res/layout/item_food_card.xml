<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/card_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Food Category / Item Icon Circle -->
        <ImageView
            android:id="@+id/iv_food_icon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_search_bar"
            android:padding="8dp"
            android:src="@drawable/ic_food"
            app:tint="@color/primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Food Title -->
        <TextView
            android:id="@+id/tv_food_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Organic Fresh Milk"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/iv_food_icon"
            app:layout_constraintTop_toTopOf="@id/iv_food_icon"
            app:layout_constraintEnd_toStartOf="@id/btn_food_menu" />

        <!-- Food Details Subtitle -->
        <TextView
            android:id="@+id/tv_food_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:text="1.0 liters • Dairy • Refrigerator"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@id/iv_food_icon"
            app:layout_constraintTop_toBottomOf="@id/tv_food_name"
            app:layout_constraintEnd_toStartOf="@id/btn_food_menu" />

        <!-- Overflow Menu Button -->
        <ImageButton
            android:id="@+id/btn_food_menu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Item options"
            android:src="@drawable/ic_edit"
            app:tint="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/divider_card"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider"
            app:layout_constraintTop_toBottomOf="@id/iv_food_icon"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Status Badge -->
        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_fresh"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Fresh"
            android:textColor="@color/status_fresh"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider_card"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Relative Expiry Countdown -->
        <TextView
            android:id="@+id/tv_expiry_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expires in 4 days"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_status_badge" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
