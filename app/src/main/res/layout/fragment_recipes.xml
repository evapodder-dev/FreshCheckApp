<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header Description -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recipes_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Intelligent matching based on your pantry &amp; expiring ingredients"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Search Input & Live Fetch Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/et_search_recipe"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_bar"
            android:paddingHorizontal="14dp"
            android:hint="@string/search_recipes"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="13sp"
            android:singleLine="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_fetch_online"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:text="TheMealDB"
            android:textColor="@color/text_on_primary"
            android:textSize="12sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="20dp" />
    </LinearLayout>

    <!-- Meal Category Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none"
        android:paddingHorizontal="12dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_recipe_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recipe_cat_all"
                style="@style/Widget.FreshCheck.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All Meals" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recipe_cat_breakfast"
                style="@style/Widget.FreshCheck.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Breakfast" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recipe_cat_lunch"
                style="@style/Widget.FreshCheck.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lunch" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recipe_cat_dinner"
                style="@style/Widget.FreshCheck.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dinner" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_recipe_cat_snacks"
                style="@style/Widget.FreshCheck.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Snacks" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Source Banner / Progress Bar -->
    <ProgressBar
        android:id="@+id/pb_recipe_loading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_recipe_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:text="Prioritizing recipes for items expiring soon"
        android:textColor="@color/primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Recipes List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_recipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_recipes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Empty"
            android:src="@drawable/ic_recipes"
            app:tint="@color/text_hint" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/empty_recipes"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
