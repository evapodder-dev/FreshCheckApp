<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- FreshCheck Base Application Theme (Light) -->
    <style name="Theme.FreshCheck" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Prevent Android 12+ starting window / splash leash freeze on emulators -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">false</item>

        <!-- Brand Color Palette -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/primary_variant</item>
        <item name="colorOnSecondary">@color/text_on_primary</item>

        <!-- Background & Surface Hierarchy -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status Bar & Navigation Bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>

        <!-- Material Component Styles -->
        <item name="cardViewStyle">@style/Widget.FreshCheck.CardView</item>
        <item name="materialButtonStyle">@style/Widget.FreshCheck.Button</item>
    </style>

    <!-- Card View Style -->
    <style name="Widget.FreshCheck.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/corner_radius_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Material Button Style -->
    <style name="Widget.FreshCheck.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Chip Style -->
    <style name="Widget.FreshCheck.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">@dimen/chip_corner_radius</item>
        <item name="chipBackgroundColor">@color/surface_variant</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/card_border</item>
        <item name="checkedIconVisible">false</item>
    </style>
</resources>
