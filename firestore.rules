rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents: only owner can read and write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Personal inventory subcollection
      match /inventory/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Shared mess documents & subcollections
    match /messes/{messId} {
      // Allow read/write if user is a member of this mess or creating a new mess
      allow read: if request.auth != null && 
        (resource == null || request.auth.uid in resource.data.memberUids);
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (request.auth.uid in resource.data.memberUids || request.auth.uid in request.resource.data.memberUids);
      allow delete: if request.auth != null && resource.data.adminUid == request.auth.uid;
      
      // Subcollections: pantry, groceries, activities
      match /pantry/{itemId} {
        allow read, write: if request.auth != null;
      }
      match /groceries/{groceryId} {
        allow read, write: if request.auth != null;
      }
      match /activities/{activityId} {
        allow read, write: if request.auth != null;
      }
      match /members/{memberUid} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Invite codes: authenticated users can read to validate; creator can write
    match /invite_codes/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.adminUid == request.auth.uid;
    }
    
    // Health check ping collection for live connection monitoring
    match /health_check/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
